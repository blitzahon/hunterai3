GROQ_API_KEY=your-groq-key-here
RAG_HOST=0.0.0.0
RAG_PORT=5000
RAG_DEBUG=false
RAG_INDEX_PATH=data/index/store.pkl
# Postgres DB for auth (example): postgres://user:password@localhost:5432/ragdb
RAG_DB_URL=

# Google sign-in. When GOOGLE_CLIENT_ID is set, every API call needs a signed-in user (or an API key).
GOOGLE_CLIENT_ID=
# Long random string used to sign session cookies; set the same value on every instance.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Optional comma-separated list of emails or @domains allowed to sign in, e.g. alice@gmail.com,@mycompany.com
ALLOWED_EMAILS=
# Set to false only for local http development on a host other than localhost.
SESSION_COOKIE_SECURE=true
# Only needed if the UI is served from a different origin than the API.
CORS_ORIGINS=
